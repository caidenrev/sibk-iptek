# Koneksi PostgreSQL.
# Supabase: Dashboard → Connect → "Session pooler" (port 5432), ganti [YOUR-PASSWORD].
# Postgres lokal/VPS: postgresql://user:password@localhost:5432/sibk
DATABASE_URL=postgresql://postgres.<project-ref>:<password-database>@aws-0-<region>.pooler.supabase.com:5432/postgres

# URL aplikasi (dipakai di tautan notifikasi)
APP_URL=http://localhost:3000

# Opsional — kunci API Supabase. SIBK tidak memakainya (hanya DATABASE_URL).
# JANGAN isi nilai asli di file ini: .env.example ikut masuk Git.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<isi-dari-dashboard>
SUPABASE_SECRET_KEY=sb_secret_<isi-dari-dashboard>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
# Kunci 32 byte (base64). Buat dengan:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# APP_ENC_KEY  : AES-256-GCM untuk ID pengirim aduan anonim & secret pengaturan
# APP_HMAC_KEY : HMAC-SHA256 untuk pengirim_hash (pencarian aduan anonim milik siswa)
# SESSION_SECRET: cadangan untuk penandatanganan token
# Jangan pernah mengganti APP_ENC_KEY / APP_HMAC_KEY setelah ada data: aduan lama tidak bisa dibuka lagi.
APP_ENC_KEY=
APP_HMAC_KEY=
SESSION_SECRET=

# Zona waktu penjadwalan & tampilan
APP_TZ=Asia/Jakarta

# ---------------------------------------------------------------- Email (SMTP)
# Kosongkan saat pengembangan: email tidak dikirim, isinya dicetak di log server.
# Resend : SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_USER=resend  SMTP_PASS=<API key Resend, awalan re_>
#          MAIL_FROM harus memakai domain yang sudah diverifikasi di Resend.
# Gmail  : SMTP_HOST=smtp.gmail.com   SMTP_PORT=465  SMTP_USER=<alamat gmail>  SMTP_PASS=<App Password 16 huruf>
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
MAIL_FROM="SIBK SMK IPTEK <sibk@domain-terverifikasi.id>"
MAIL_REPLY_TO=

# ---------------------------------------------------------------- WhatsApp (Fonnte)
# Kosongkan saat pengembangan: pesan WA dicetak di log server.
FONNTE_TOKEN=

# Kunci untuk endpoint /api/cron (cron-job.org mengirimnya di header Authorization: Bearer <kunci>).
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=FjElBnqVMWj3m2jGVE8YQFjqqb4m3omJm2FDVa9jGpU

# Mode pengembangan: notifikasi otomatis hanya dicetak ke log (akun uji bisa memakai alamat sungguhan).
# Isi true untuk benar-benar mengirim saat pengembangan. Di produksi selalu dikirim.
NOTIF_KIRIM_NYATA=false
